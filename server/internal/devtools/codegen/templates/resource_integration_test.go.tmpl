// Generated by cmd/gen: a smoke test of the [[.Name]] API. It needs the table
// to be created by a migration. Extend it with the resource's own rules.

// [[.Lower]]TestGuard admits every request as a super admin with full data
// scope; permission enforcement is covered by the app tests.
type [[.Lower]]TestGuard struct{}

func ([[.Lower]]TestGuard) Require(access.Level) gin.HandlerFunc {
	return func(c *gin.Context) {
		a := &actor.Actor{Snapshot: &actor.Snapshot{UserID: 1, IsSuper: true, DataScope: datascope.Resolved{All: true}}}
		c.Request = c.Request.WithContext(actor.With(c.Request.Context(), a))
	}
}

type [[.Lower]]Envelope struct {
	Code int             `json:"code"`
	Data json.RawMessage `json:"data"`
}

func new[[.Upper]]TestServer(t *testing.T) http.Handler {
	t.Helper()
	gin.SetMode(gin.TestMode)
	cfg := migrated.Database(t)
	sqlDB, err := database.OpenSQL(context.Background(), cfg, "[[.Pkg]]-test")
	require.NoError(t, err)
	t.Cleanup(func() { _ = sqlDB.Close() })
	db, err := database.NewGorm(sqlDB, cfg, zap.NewNop())
	require.NoError(t, err)
	if !db.Migrator().HasTable([[.Lower]]Table) {
		t.Skip([[.Lower]]Table + " is not created by this project's migrations (another service owns it): " +
			"create it in the test to run these tests")
	}
	engine := gin.New()
	m := New(Deps{DB: db})
	m.[[.Lower]]Routes(module.NewRouter(engine.Group("/api/v1"), Name, [[.Lower]]TestGuard{}, module.NewRegistry()))
	return engine
}

func call[[.Upper]](t *testing.T, h http.Handler, method, path string, body any) (int, [[.Lower]]Envelope) {
	t.Helper()
	var buf bytes.Buffer
	if body != nil {
		require.NoError(t, json.NewEncoder(&buf).Encode(body))
	}
	req := httptest.NewRequest(method, path, &buf)
	req.Header.Set("Content-Type", "application/json")
	rec := httptest.NewRecorder()
	h.ServeHTTP(rec, req)
	var env [[.Lower]]Envelope
	if strings.HasPrefix(rec.Header().Get("Content-Type"), "application/json") {
		require.NoError(t, json.Unmarshal(rec.Body.Bytes(), &env))
	}
	return rec.Code, env
}

[[- if .ReadOnly]]

func Test[[.Upper]]ReadOnly(t *testing.T) {
	h := new[[.Upper]]TestServer(t)
	const base = "/api/v1[[.URLPath]]"
	status, env := call[[.Upper]](t, h, http.MethodGet, base+"?page=1&pageSize=10", nil)
	require.Equal(t, http.StatusOK, status, string(env.Data))
	status, _ = call[[.Upper]](t, h, http.MethodGet, base+"/export", nil)
	assert.Equal(t, http.StatusOK, status)
	status, _ = call[[.Upper]](t, h, http.MethodGet, base+"/[[.MissingKey]]", nil)
	assert.Equal(t, http.StatusNotFound, status)
	status, _ = call[[.Upper]](t, h, http.MethodPost, base, map[string]any{})
	assert.Equal(t, http.StatusNotFound, status, "a read-only module has no create route")
}
[[- else]]

func Test[[.Upper]]CRUD(t *testing.T) {
	h := new[[.Upper]]TestServer(t)
	const base = "/api/v1[[.URLPath]]"
	// Adjust the sample values to satisfy foreign keys and business rules.
	payload := map[string]any{
[[- range .SampleFields]]
		"[[.JSONName]]": [[.Sample]],
[[- end]]
[[- range .Children]][[if not .KeyFromTable]]
		"[[.JSONName]]": []any{map[string]any{"[[.Key.JSONName]]": [[.KeySample]][[range .Fields]], "[[.JSONName]]": [[.SampleValue]][[end]]}},
[[- end]][[end]]
	}

	status, env := call[[.Upper]](t, h, http.MethodPost, base, payload)
	require.Equal(t, http.StatusOK, status, string(env.Data))
	var created struct {
		Key     json.RawMessage `json:"[[.PK.JSONName]]"`
		Version int             `json:"version"`
	}
	require.NoError(t, json.Unmarshal(env.Data, &created))
	key := strings.Trim(string(created.Key), `"`)
	require.NotEmpty(t, key)
[[- if .UniqueFields]]

	// The same unique value again is a field error, not a 409.
	status, env = call[[.Upper]](t, h, http.MethodPost, base, payload)
	assert.Equal(t, http.StatusUnprocessableEntity, status, string(env.Data))
	assert.Contains(t, string(env.Data), [[goString (index .UniqueFields 0).JSONName]])
[[- end]]

	status, env = call[[.Upper]](t, h, http.MethodGet, base+"?page=1&pageSize=10", nil)
	require.Equal(t, http.StatusOK, status)
	var page struct {
		Total int64 `json:"total"`
	}
	require.NoError(t, json.Unmarshal(env.Data, &page))
	assert.Equal(t, int64(1), page.Total)

	status, env = call[[.Upper]](t, h, http.MethodGet, base+"/"+key, nil)
	assert.Equal(t, http.StatusOK, status)
[[- range .Children]][[if not .KeyFromTable]]
	assert.Contains(t, string(env.Data), `"[[.JSONName]]":[{`, "the detail has the [[.Label]] rows")
[[- end]][[end]]
[[- if .Version]]

	payload["version"] = created.Version
	status, env = call[[.Upper]](t, h, http.MethodPut, base+"/"+key, payload)
	require.Equal(t, http.StatusOK, status, string(env.Data))
	status, _ = call[[.Upper]](t, h, http.MethodPut, base+"/"+key, payload)
	assert.Equal(t, http.StatusConflict, status, "a stale version is rejected")
[[- else]]

	status, env = call[[.Upper]](t, h, http.MethodPut, base+"/"+key, payload)
	require.Equal(t, http.StatusOK, status, string(env.Data))
[[- end]]

	status, _ = call[[.Upper]](t, h, http.MethodGet, base+"/export", nil)
	assert.Equal(t, http.StatusOK, status)

	status, _ = call[[.Upper]](t, h, http.MethodDelete, base+"/"+key, nil)
	require.Equal(t, http.StatusOK, status)
	status, _ = call[[.Upper]](t, h, http.MethodGet, base+"/"+key, nil)
	assert.Equal(t, http.StatusNotFound, status)
}
[[- end]]
