<script setup lang="ts">
import { computed, onMounted, reactive, ref, type Component } from "vue";
import { usePagedTable } from "@/composables/usePagedTable";
[[- if .SearchFields]]
import { useRouteFilter } from "@/composables/useRouteFilter";
[[- end]]
[[- if .CanDelete]]
import { confirmAction } from "@/composables/useConfirmAction";
[[- end]]
import {
[[- if .CanDelete]]
  delete[[.TSUpper]],
  [[.Lower]]Key,
[[- end]]
  export[[.TSPluralUpper]],
  list[[.TSPluralUpper]],
[[- if .Features]]
  get[[.TSUpper]]Features,
[[- end]]
[[- range .Children]][[if and .Spec.ListKeys .KeyFromTable]]
  list[[$.TSUpper]][[.GoName]]Keys,
[[- end]][[end]]
[[- range .RelationSearch]]
  [[.RelOptionsTS]],
[[- end]]
  type [[.TSUpper]],
  type [[.TSUpper]]Filter
} from "@/api/[[.Pkg]]/[[.Resource]]";
[[- if .RelationSearch]]
import ReRemoteSelect from "@/components/ReRemoteSelect/index.vue";
[[- end]]
[[- if .StatusSearch]]
import { STATUS_OPTIONS } from "@/api/types";
[[- end]]
[[- if .StatusInTable]]
import ReStatusTag from "@/components/ReStatusTag/index.vue";
[[- end]]
[[- if .DeptSearch]]
import { getDeptTree, type Dept } from "@/api/iam/dept";
import { DEPT_TREE_PROPS } from "@/utils/tree-options";
[[- end]]
[[- if .TableHasTime]]
import ReDateTime from "@/components/ReDateTime/index.vue";
[[- end]]
[[- if .IndexFormatImport]]
import { [[.IndexFormatImport]] } from "@/utils/format";
[[- end]]
[[- if not .ReadOnly]]
import { hasPerm } from "@/utils/permission";
[[- end]]
[[- if .IndexDictImport]]
import { [[.IndexDictImport]] } from "@/composables/useDict";
[[- end]]
[[- if not .ReadOnly]]
import [[.TSUpper]]FormDialog from "./components/[[.TSUpper]]FormDialog.vue";
[[- end]]
import { extensionOptions } from "@/utils/extension";
import [[.TSUpper]]Extension, * as [[.Lower]]Extension from "./components/[[.TSUpper]]Extension.vue";

defineOptions({ name: "[[.ViewName]]" });

/** 扩展文件导出的选项（行按钮、说明区、展开行、接管的列、行内按钮条件） */
const ext = extensionOptions<[[.TSUpper]]>([[.Lower]]Extension);
/** header / expand / cell：扩展文件早于这些位置时，其 place 类型里没有它们 */
const [[.TSUpper]]ExtensionPlace = [[.TSUpper]]Extension as Component;
[[- if not .ReadOnly]]

/** 没有任何行操作权限（也没有扩展的行按钮）时隐藏「操作」列 */
const showRowActions = computed(
  () =>
    ext.hasRowActions ||
    ["[[.PermPrefix]]:update"[[if .CanDelete]], "[[.PermPrefix]]:delete"[[end]]].some(code =>
      hasPerm(code)
    )
);
[[- end]]

[[- range .IndexDicts]]
const { [[.DictBindings]] } = [[.DictSource]];
[[- end]]
[[- range .Children]][[if .Spec.ListKeys]]
[[- if .KeyFromTable]]

/** [[.Label]]的[[.Key.Label]]名称（来自 [[.Spec.KeyTable]]），用于「[[.ListKeysLabel]]」列 */
const [[.JSONName]]KeyNames = ref<Record<string, string>>({});
onMounted(async () => {
  try {
    const keys = (await list[[$.TSUpper]][[.GoName]]Keys()) ?? [];
    [[.JSONName]]KeyNames.value = Object.fromEntries(
      keys.map(k => [k.value, k.label])
    );
  } catch {
    // 错误提示已由 http 拦截器处理；列中显示原值
  }
});
const [[.JSONName]]KeyLabel = (v: string) => [[.JSONName]]KeyNames.value[v] ?? v;
[[- else]]
const { labelOf: [[.JSONName]]KeyLabel } = useDict([[printf "%q" .Spec.KeyDict]]);
[[- end]]
[[- end]][[end]]
[[- if .Features]]

/** 功能开关：关闭时对应字段不显示 */
const features = ref<Record<string, boolean>>({});
onMounted(async () => {
  try {
    features.value = (await get[[.TSUpper]]Features()) ?? {};
  } catch {
    // 错误提示已由 http 拦截器处理
  }
});
[[- end]]
[[- if .DictBool]]

/** 是/否字段的选项值为 1 和 0 */
const dictBool = (v: boolean | null) => (v === null ? null : v ? 1 : 0);
[[- end]]

const emptyFilter = (): [[.TSUpper]]Filter => ({[[.FilterInit]]});
const filter = reactive<[[.TSUpper]]Filter>(emptyFilter());
[[- if .DateRanges]]
/** 日期范围选择器的值，查询时拆成起止两个参数 */
const ranges = reactive<{
[[- range .DateRanges]]
  [[.JSONName]]: string[] | null;
[[- end]]
}>({
[[- range $i, $f := .DateRanges]][[if $i]],[[end]] [[$f.JSONName]]: null[[end]] });

function query(): [[.TSUpper]]Filter {
  return {
    ...filter,
[[- range .DateRanges]]
    [[.JSONName]]Start: ranges.[[.JSONName]]?.[0],
    [[.JSONName]]End: ranges.[[.JSONName]]?.[1],
[[- end]]
  };
}
[[- else]]
const query = (): [[.TSUpper]]Filter => ({ ...filter });
[[- end]]
const {
  loading,
  rows,
  pagination,
  reload,
[[- if .SearchFields]]
  search,
[[- end]]
  onSizeChange,
  onCurrentChange
} = usePagedTable<[[.TSUpper]]>(q => list[[.TSPluralUpper]]({ ...q, ...query() }));
[[- if .DeptSearch]]
const deptTree = ref<Dept[]>([]);
[[- end]]

const exporting = ref(false);
[[- if not .ReadOnly]]
const dialogVisible = ref(false);
const editing = ref<[[.TSUpper]] | null>(null);
[[- if .CanCreate]]

function openCreate(): void {
  editing.value = null;
  dialogVisible.value = true;
}
[[- end]]

function openEdit(row: [[.TSUpper]]): void {
  editing.value = row;
  dialogVisible.value = true;
}
[[- if .CanDelete]]

function remove(row: [[.TSUpper]]): void {
  confirmAction({
[[- if .DeleteConfirmTS]]
    confirm: [[.DeleteConfirmTS]],
[[- else if .DisplayField]]
    confirm: `确定删除[[.Name]]「${row.[[.DisplayField.JSONName]]}」吗？`,
[[- else]]
    confirm: `确定删除该[[.Name]]（[[.PK.Label]]：${row.[[.PK.JSONName]]}）吗？`,
[[- end]]
    success: "已删除",
    action: () => delete[[.TSUpper]]([[.Lower]]Key(row)),
    reload
  });
}
[[- end]]
[[- end]]
[[- if .SearchFields]]

/** 筛选回到默认值 */
function clearFilter(): void {
  Object.assign(filter, emptyFilter());
[[- range .DateRanges]]
  ranges.[[.JSONName]] = null;
[[- end]]
}

function resetFilter(): void {
  clearFilter();
  search();
}
[[- end]]

async function onExport(): Promise<void> {
  exporting.value = true;
  try {
    await export[[.TSPluralUpper]](query());
  } catch {
    // 错误提示已由 http 拦截器处理
  } finally {
    exporting.value = false;
  }
}

[[- if .SearchFields]]
// 地址栏中与筛选同名的参数（如 ?[[(index .SearchFields 0).JSONName]]=...）填入筛选后查询
useRouteFilter({
  filter,
  kinds: { [[join .FilterKinds ", "]] },
[[- if .DateRanges]]
  ranges,
[[- end]]
  reset: clearFilter,
  search
});
[[- else]]
onMounted(reload);
[[- end]]
[[- if .DeptSearch]]
onMounted(async () => {
  try {
    deptTree.value = (await getDeptTree()) ?? [];
  } catch {
    deptTree.value = [];
  }
});
[[- end]]
</script>

<template>
  <div class="main">
[[- if .SearchFields]]
    <el-card shadow="never" class="mb-3" body-class="pb-0!">
      <el-form :inline="true" :model="filter" @submit.prevent="search">
[[- range .SearchFields]]
        <el-form-item label="[[.Label]][[if and (eq .SearchWidget "dateRange") (eq .Kind "time")]](UTC)[[end]]">
[[- if eq .SearchWidget "status"]]
          <el-select
            v-model="filter.[[.JSONName]]"
            placeholder="全部"
            clearable
            class="w-[120px]!"
          >
            <el-option
              v-for="o in STATUS_OPTIONS"
              :key="o.value"
              :label="o.label"
              :value="o.value"
            />
          </el-select>
[[- else if eq .SearchWidget "dict"]]
          <el-select
            v-model="filter.[[.JSONName]]"
            placeholder="全部"
            clearable
            class="w-[140px]!"
          >
            <el-option
              v-for="o in [[.JSONName]]Options"
              :key="o.value"
              :label="o.label"
              :value="o.value"
            />
          </el-select>
[[- else if eq .SearchWidget "dept"]]
          <el-tree-select
            v-model="filter.[[.JSONName]]"
            :data="deptTree"
            :props="DEPT_TREE_PROPS"
            node-key="id"
            check-strictly
            clearable
            filterable
            placeholder="全部"
            class="w-[180px]!"
          />
[[- else if eq .SearchWidget "relation"]]
          <ReRemoteSelect
            v-model="filter.[[.JSONName]]"
            :fetch="(kw: string) => [[.RelOptionsTS]](kw, true)"
            placeholder="[[if .RelNumber]]输入编号[[else]]全部[[end]]"
            class="w-[180px]!"
          />
[[- else if eq .SearchWidget "bool"]]
          <el-select
            v-model="filter.[[.JSONName]]"
            placeholder="全部"
            clearable
            class="w-[100px]!"
          >
            <el-option label="是" :value="true" />
            <el-option label="否" :value="false" />
          </el-select>
[[- else if eq .SearchWidget "number"]]
          <el-input-number
            v-model="filter.[[.JSONName]]"
            :controls="false"
            placeholder="[[.Label]]"
            class="w-[140px]!"
          />
[[- else if eq .SearchWidget "date"]]
          <el-date-picker
            v-model="filter.[[.JSONName]]"
            type="date"
            value-format="YYYY-MM-DD"
            placeholder="选择日期"
            class="w-[160px]!"
          />
[[- else if eq .SearchWidget "numberRange"]]
          <div class="flex items-center gap-1">
            <el-input-number
              v-model="filter.[[.JSONName]]Min"
              :controls="false"
              placeholder="最小"
              class="w-[100px]!"
            />
            <span>-</span>
            <el-input-number
              v-model="filter.[[.JSONName]]Max"
              :controls="false"
              placeholder="最大"
              class="w-[100px]!"
            />
          </div>
[[- else if eq .SearchWidget "decimalRange"]]
          <div class="flex items-center gap-1">
            <el-input
              v-model="filter.[[.JSONName]]Min"
              placeholder="最小"
              clearable
              class="w-[110px]!"
            />
            <span>-</span>
            <el-input
              v-model="filter.[[.JSONName]]Max"
              placeholder="最大"
              clearable
              class="w-[110px]!"
            />
          </div>
[[- else if eq .SearchWidget "dateRange"]]
          <el-date-picker
            v-model="ranges.[[.JSONName]]"
            type="daterange"
            value-format="YYYY-MM-DD"
            range-separator="至"
            start-placeholder="开始日期"
            end-placeholder="结束日期"
            class="w-[240px]!"
          />
[[- else]]
          <el-input
            v-model="filter.[[.JSONName]]"
            placeholder="[[.Label]]"
            clearable
            class="w-[180px]!"
            @keyup.enter="search"
          />
[[- end]]
        </el-form-item>
[[- end]]
        <el-form-item>
          <el-button type="primary" :loading="loading" @click="search">
            搜索
          </el-button>
          <el-button @click="resetFilter">重置</el-button>
        </el-form-item>
      </el-form>
    </el-card>
[[- end]]
    <el-card shadow="never">
      <div class="mb-3 flex justify-between">
        <span class="card-title">[[.Name]]列表</span>
        <div class="flex items-center">
          <!-- 扩展按钮写在 [[.TSUpper]]Extension.vue（重新生成不会覆盖） -->
          <[[.TSUpper]]Extension place="toolbar" class="mr-3" @reload="reload" />
[[- if .CanCreate]]
          <el-button
            v-perm="'[[.PermPrefix]]:create'"
            type="primary"
            @click="openCreate"
          >
            新增[[.Name]]
          </el-button>
[[- end]]
          <el-button
            v-perm="'[[.PermPrefix]]:export'"
            :loading="exporting"
            @click="onExport"
          >
            导出 CSV
          </el-button>
        </div>
      </div>
      <!-- 说明区写在 [[.TSUpper]]Extension.vue（hasHeader） -->
      <[[.TSUpper]]ExtensionPlace
        v-if="ext.hasHeader"
        place="header"
        class="mb-3 block"
        @reload="reload"
      />
      <el-table v-loading="loading" :data="rows" row-key="[[.PK.JSONName]]" border>
        <el-table-column v-if="ext.hasExpand" type="expand">
          <template #default="{ row }">
            <[[.TSUpper]]ExtensionPlace
              place="expand"
              :row="row as [[.TSUpper]]"
              @reload="reload"
            />
          </template>
        </el-table-column>
[[- range .TableFields]]
        <el-table-column[[.ColumnIf]] label="[[.Label]]" [[.ColumnAttrs]]>
          <template #default="{ row }">
            <[[$.TSUpper]]ExtensionPlace
              v-if="ext.cellColumns.includes('[[.JSONName]]')"
              place="cell"
              column="[[.JSONName]]"
              :row="row as [[$.TSUpper]]"
              @reload="reload"
            />
[[- template "indexCell" .]]
          </template>
        </el-table-column>
[[- end]]
[[- range $c := .Children]][[range .ListColumns]]
        <el-table-column label="[[.Label]]" min-width="140" show-overflow-tooltip>
          <template #default="{ row }">{{ row.[[.JSONName]] || "-" }}</template>
        </el-table-column>
[[- end]][[end]]
[[- range .Children]][[if .Spec.ListKeys]]
        <el-table-column label="[[.ListKeysLabel]]" min-width="160" show-overflow-tooltip>
          <template #default="{ row }">
            {{
              (row.[[.JSONName]]Keys ?? []).map([[.JSONName]]KeyLabel).join("、") || "-"
            }}
          </template>
        </el-table-column>
[[- end]][[end]]
[[- if not .ReadOnly]]
        <el-table-column
          v-if="showRowActions"
          label="操作"
          width="150"
          fixed="right"
        >
          <template #default="{ row }">
            <el-button
              v-if="ext.canEdit(row as [[.TSUpper]])"
              v-perm="'[[.PermPrefix]]:update'"
              link
              type="primary"
              @click="openEdit(row as [[.TSUpper]])"
            >
              编辑
            </el-button>
[[- if .CanDelete]]
            <el-button
              v-if="ext.canDelete(row as [[.TSUpper]])"
              v-perm="'[[.PermPrefix]]:delete'"
              link
              type="danger"
              @click="remove(row as [[.TSUpper]])"
            >
              删除
            </el-button>
[[- end]]
            <[[.TSUpper]]Extension
              place="row"
              :row="row as [[.TSUpper]]"
              @reload="reload"
            />
          </template>
        </el-table-column>
[[- else]]
        <el-table-column
          v-if="ext.hasRowActions"
          label="操作"
          width="150"
          fixed="right"
        >
          <template #default="{ row }">
            <[[.TSUpper]]Extension
              place="row"
              :row="row as [[.TSUpper]]"
              @reload="reload"
            />
          </template>
        </el-table-column>
[[- end]]
      </el-table>
      <el-pagination
        class="mt-3 justify-end"
        :current-page="pagination.currentPage"
        :page-size="pagination.pageSize"
        :page-sizes="[10, 20, 50, 100]"
        :total="pagination.total"
        layout="total, sizes, prev, pager, next, jumper"
        background
        @size-change="onSizeChange"
        @current-change="onCurrentChange"
      />
    </el-card>

[[- if not .ReadOnly]]
    <[[.TSUpper]]FormDialog
      v-model="dialogVisible"
      :row="editing"[[if .Features]]
      :features="features"[[end]]
      @saved="reload"
      @reload="reload"
    />
[[- end]]
  </div>
</template>

[[- define "indexCell"]]
[[- if eq .Role "status"]]
            <ReStatusTag v-else :status="row.status" />
[[- else if or (eq .Upload "image") (eq .Format "image")]]
            <template v-else>
              <el-image
                v-if="row.[[.JSONName]]"
                :src="row.[[.JSONName]]"
                :preview-src-list="[row.[[.JSONName]]]"
                fit="cover"
                preview-teleported
                class="w-10 h-10 rounded"
              />
              <span v-else>-</span>
            </template>
[[- else if eq .Upload "files"]]
            <span v-else>
              {{ row.[[.JSONName]].length ? `${row.[[.JSONName]].length} 个` : "-" }}
            </span>
[[- else if .Dict]]
            <template v-else>
              <el-tag
                v-if="[[.JSONName]]Label([[.DictRowTS]]) !== '-'"
                :type="[[.JSONName]]TagType([[.DictRowTS]])"
                disable-transitions
              >
                {{ [[.JSONName]]Label([[.DictRowTS]]) }}
              </el-tag>
              <span v-else>-</span>
            </template>
[[- else if .Relation]]
[[- if .ExtraGo]]
            <span v-else>{{ relationLabel(row.[[.LabelJSON]], row.[[.ExtraJSON]]) }}</span>
[[- else]]
            <span v-else>{{ row.[[.LabelJSON]] || "-" }}</span>
[[- end]]
[[- else if eq .Role "dept_id"]]
            <span v-else>{{ row.deptName || "-" }}</span>
[[- else if eq .Kind "time"]]
            <ReDateTime v-else :value="row.[[.JSONName]]" />
[[- else if eq .Kind "bool"]]
            <el-tag v-else :type="row.[[.JSONName]] ? 'success' : 'info'">
              {{ row.[[.JSONName]] ? "是" : "否" }}
            </el-tag>
[[- else if eq .Format "signed"]]
            <span v-else :class="signClass(row.[[.JSONName]])">{{ [[.FormatCall]] }}</span>
[[- else if .Format]]
            <span v-else>{{ [[.FormatCall]] }}</span>
[[- else if .Nullable]]
            <span v-else>{{ row.[[.JSONName]] ?? "-" }}</span>
[[- else]]
            <span v-else>{{ row.[[.JSONName]] }}</span>
[[- end]]
[[- end]]
