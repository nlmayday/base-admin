import { http } from "@/utils/http";
import {
  compactParams,
  type Page,
  type PageQuery[[if .OptionRelations]],
  type LookupOption[[end]][[if .Status]],
  type Status[[end]]
} from "@/api/types";
[[- if .HasFiles]]
import type { AttachmentRef } from "@/api/file";
[[- end]]

[[- range $c := .Children]]

/** [[.Label]]（[[.Table]]）的一行，按[[.Key.Label]]区分 */
export type [[$.TSUpper]][[.GoName]] = {
  /** [[.Key.Label]] */
  [[.Key.JSONName]]: [[.Key.TSType]];
[[- range .Fields]]
  /** [[.Label]] */
  [[.JSONName]]: [[.TSType]];
[[- end]]
};
[[- if .KeyFromTable]]

/** [[.Label]]可用的[[.Key.Label]]（来自 [[.Spec.KeyTable]]），required 为必须填写 */
export type [[$.TSUpper]][[.GoName]]Key = {
  value: string;
  label: string;
  required: boolean;
};
[[- end]]
[[- end]]

/** [[.Name]]（[[.Table]]），由 cmd/gen 生成 */
export type [[.TSUpper]] = {
[[- range .Fields]]
  /** [[.Label]] */
  [[.JSONName]]: [[.TSType]];
[[- end]]
[[- if .DeptJoin]]
  /** 部门名称 */
  deptName: string;
[[- end]]
[[- range .Relations]]
  /** [[.LabelDoc]] */
  [[.LabelJSON]]: string;
[[- end]]
[[- range .Children]]
  /** [[.Label]]：详情接口返回，列表不返回 */
  [[.JSONName]]?: [[$.TSUpper]][[.GoName]][];
[[- if .Spec.ListKeys]]
  /** 已填[[.Label]]的[[.Key.Label]]：列表接口返回 */
  [[.JSONName]]Keys?: string[];
[[- end]]
[[- end]]
};

[[- if .SearchFields]]
export type [[.TSUpper]]Filter = {
[[- range .SearchFields]]
[[- range .FilterTS]]
  [[.]]
[[- end]]
[[- end]]
};
[[- else]]
/** 没有搜索项 */
export type [[.TSUpper]]Filter = Record<never, never>;
[[- end]]

[[- if not .ReadOnly]]

export type [[.TSUpper]]Payload = {
[[- range .Writable]]
  [[.JSONName]]: [[.TSReqType]];
[[- end]]
[[- range .Children]]
  [[.JSONName]]: [[$.TSUpper]][[.GoName]][];
[[- end]]
};
[[- if .Version]]

export type [[.TSUpper]]UpdatePayload = [[.TSUpper]]Payload & { version: number };
[[- end]]
[[- end]]

const enc = encodeURIComponent;

export const list[[.TSPluralUpper]] = (query: PageQuery & [[.TSUpper]]Filter) =>
  http.get<Page<[[.TSUpper]]>>("[[.URLPath]]", compactParams(query));

/** 行的主键（[[.PK.Column]]），用于详情、编辑、删除的路径 */
export const [[.Lower]]Key = (row: [[.TSUpper]]): string => String(row.[[.PK.JSONName]]);

export const get[[.TSUpper]] = (id: string) =>
  http.get<[[.TSUpper]]>(`[[.URLPath]]/${enc(id)}`);
[[- if not .ReadOnly]]
[[- if .CanCreate]]

export const create[[.TSUpper]] = (data: [[.TSUpper]]Payload) =>
  http.post<[[.TSUpper]]>("[[.URLPath]]", data);
[[- end]]

export const update[[.TSUpper]] = (
  id: string,
  data: [[.TSUpper]][[if .Version]]Update[[end]]Payload
) => http.put<[[.TSUpper]]>(`[[.URLPath]]/${enc(id)}`, data);

[[- if .CanDelete]]

export const delete[[.TSUpper]] = (id: string) =>
  http.delete<null>(`[[.URLPath]]/${enc(id)}`);
[[- end]]
[[- end]]

export const export[[.TSPluralUpper]] = (filter: [[.TSUpper]]Filter) =>
  http.download("[[.URLPath]]/export", compactParams(filter), "[[.URLName]].csv");
[[- range .Children]][[if .KeyFromTable]]

/** [[.Label]]可用的[[.Key.Label]] */
export const list[[$.TSUpper]][[.GoName]]Keys = () =>
  http.get<[[$.TSUpper]][[.GoName]]Key[]>("/[[$.URLName]]/options/[[.JSONName]]Keys");
[[- end]][[end]]
[[- range .OptionRelations]]

/** [[.Label]]选项：按[[if .RelNumber]]编号[[else]]关键字[[end]]搜索 [[.RelTable]]；deleted 为 true 时包含已删除的记录（搜索栏用） */
export const [[.RelOptionsTS]] = (keyword: string, deleted = false) =>
  http.get<LookupOption[]>("/[[$.URLName]]/options/[[.JSONName]]", {
    keyword,
    deleted: deleted ? 1 : undefined
  });
[[- end]]
