	if err := checkDict(ctx, m.dict, [[goString .Dict]], [[goString .JSONName]], [[goString .Label]], req.[[.GoName]]); err != nil {
		return nil, err
	}
[[- end]]
[[- range .RelationFields]]
[[- if .Nullable]]
	if req.[[.GoName]] != nil {
		if err := check[[$.Upper]]Relation(ctx, m.db, [[.RelVar]], [[goString .JSONName]], [[goString .Label]], int64(*req.[[.GoName]])); err != nil {
			return nil, err
		}
	}
[[- else]]
	if err := check[[$.Upper]]Relation(ctx, m.db, [[.RelVar]], [[goString .JSONName]], [[goString .Label]], int64(req.[[.GoName]])); err != nil {
		return nil, err
	}
[[- end]]
[[- end]]
[[- range .UploadFields]]
[[- if eq .Upload "files"]]
	if msg := attachment.RefsProblem(req.[[.GoName]]); msg != "" {
		return nil, fieldError([[goString .JSONName]], msg)
	}
[[- else if .Nullable]]
	if req.[[.GoName]] != nil {
		if msg := attachment.URLProblem(*req.[[.GoName]]); msg != "" {
			return nil, fieldError([[goString .JSONName]], msg)
		}
	}
[[- else]]
	if msg := attachment.URLProblem(req.[[.GoName]]); msg != "" {
		return nil, fieldError([[goString .JSONName]], msg)
	}
[[- end]]
[[- end]]
	sets := map[string]any{
[[- range .UpdateFields]]
		"[[.Column]]": [[.UpdateArg]],
[[- end]]
[[- if .UpdatedBy]]
		"updated_by": actor.From(ctx).UserID(),
[[- end]]
[[- if .UpdatedAt]]
		"updated_at": gorm.Expr("CURRENT_TIMESTAMP(6)"),
[[- end]]
	}
	var view [[.Lower]]View
	err = database.RunTx(ctx, m.db, func(tx *gorm.DB) error {
		if _, err := m.load[[.Upper]](ctx, tx, key); err != nil {
			return err
		}
[[- if .Version]]
		// Optimistic locking (design doc 8.1): the row must still have the
		// version the client read.
		sets["version"] = gorm.Expr("version + 1")
		res := tx.Table([[.Lower]]Table).Where("[[.PK.Quoted]] = ? AND version = ?", key, *req.Version).Updates(sets)
		if res.Error != nil {
			if constraint, ok := database.UniqueConstraint(res.Error); ok {
				return [[.Lower]]Duplicate(constraint)
			}
			if database.IsValueTooLong(res.Error) {
				return err[[.Upper]]TooLong
			}
			return res.Error
		}
		if res.RowsAffected == 0 {
			return errVersionConflict
		}
[[- else]]
		if err := tx.Table([[.Lower]]Table).Where("[[.PK.Quoted]] = ?", key).Updates(sets).Error; err != nil {
			if constraint, ok := database.UniqueConstraint(err); ok {
				return [[.Lower]]Duplicate(constraint)
			}
			if database.IsValueTooLong(err) {
				return err[[.Upper]]TooLong
			}
			return err
		}
[[- end]]
[[- range .Children]]
		if req.[[.GoName]] != nil {
			if err := m.save[[$.Upper]][[.GoName]](ctx, tx, key, req.[[.GoName]]); err != nil {
				return err
			}
		}
[[- end]]
		var err error
		view, err = [[if .Dept]]m.reload[[else]]m.load[[end]][[.Upper]](ctx, tx, key)
		if err != nil {
			return err
		}
		return m.[[.Lower]]AfterSave(ctx, tx, view, false)
	})
	if err != nil {
		return nil, err
	}
	return view, nil
}

func (m *Module) delete[[.Upper]](c *gin.Context) (any, error) {
	key, err := parse[[.Upper]]Key(c)
	if err != nil {
		return nil, err
	}
	ctx := c.Request.Context()
	return nil, database.RunTx(ctx, m.db, func(tx *gorm.DB) error {
		if _, err := m.load[[.Upper]](ctx, tx, key); err != nil {
			return err
		}
[[- if .SoftDelete]]
		if err := tx.Exec(`UPDATE [[.Table]] SET [[.SoftDeleteSets]] WHERE [[.PK.Quoted]] = ? AND deleted_at IS NULL`,
			[[if .UpdatedBy]]actor.From(ctx).UserID(), [[end]]key).Error; err != nil {
			return err
		}
[[- else]]
[[- range .Children]]
		if err := tx.Exec(`DELETE FROM [[.Table]] WHERE [[.FK.Quoted]] = ?`, key).Error; err != nil {
			return err
		}
[[- end]]
		err := tx.Exec(`DELETE FROM [[.Table]] WHERE [[.PK.Quoted]] = ?`, key).Error
		if database.IsForeignKeyViolation(err) {
			return httpx.Conflict("[[.Name]]已被引用，不能删除")
		}
		if err != nil {
			return err
		}
[[- end]]
		return m.[[.Lower]]AfterDelete(ctx, tx, key)
	})
}
[[- end]]

func (m *Module) export[[.PluralUpper]](c *gin.Context) {
	f, err := bind[[.Upper]]Filter(c)
	if err != nil {
		httpx.Fail(c, err)
		return
	}
	ctx := c.Request.Context()
	q := apply[[.Upper]]Filter(m.scoped[[.PluralUpper]](ctx, m.db), f)
	// Over the limit set in 基础设置 the export is refused, never cut short.
	maxRows, err := export.Check(ctx, m.db, q)
	if err != nil {
		httpx.Fail(c, err)
		return
	}
[[- range .ExportDicts]]
	[[.JSONName]]Labels, err := dictLabels(ctx, m.dict, [[goString .Dict]])
	if err != nil {
		httpx.Fail(c, err)
		return
	}
[[- end]]
	var rows [][[.Lower]]Row
	if err := q.Select([[.Lower]]Columns(q)).Order("[[.Order]]").Limit(maxRows).Scan(&rows).Error; err != nil {
		httpx.Fail(c, err)
		return
	}

	filename := fmt.Sprintf("[[.URLName]]-%s.csv", time.Now().Format("20060102-150405"))
	c.Header("Content-Type", "text/csv; charset=utf-8")
	c.Header("Content-Disposition", `attachment; filename="`+filename+`"`)
	// UTF-8 BOM so spreadsheet tools detect the encoding of Chinese text.
	_, _ = c.Writer.WriteString("\xef\xbb\xbf")
	w := csv.NewWriter(c.Writer)
	// Times are written in UTC, as the headers say.
	_ = w.Write([]string{[[range $i, $f := .ExportFields]][[if $i]], [[end]][[if eq $f.Kind "time"]]export.TimeHeader([[goString $f.Label]])[[else]][[goString $f.Label]][[end]][[end]]})
	for _, r := range rows {
		_ = w.Write([]string{
[[- range .ExportFields]]
[[- if eq .Role "status"]]
			[[$.Lower]]StatusLabels[int(r.Status)],
[[- else if and (eq .Role "dept_id") $.DeptJoin]]
			csvValue(r.DeptName), // the department name instead of its ID
[[- else if .Relation]]
			csvValue(r.[[.LabelGo]]), // the [[.Label]] name instead of its ID
[[- else if .Enum]]
			[[$.Lower]]Label([[$.Lower]][[.GoName]]Labels, optionKey(r.[[.GoName]])), // the option instead of its value
[[- else if .Dict]]
			[[$.Lower]]Label([[.JSONName]]Labels, optionKey(r.[[.GoName]])), // the dictionary label instead of the value
[[- else]]
			csvValue(r.[[.GoName]]),
[[- end]]
[[- end]]
		})
	}
	w.Flush()
}
[[- if or .EnumExports .ExportDicts]]
[[- range .EnumExports]]

// [[$.Lower]][[.GoName]]Labels are the options of [[.Column]] (column comment), for the export.
var [[$.Lower]][[.GoName]]Labels = map[string]string{[[range $i, $o := .Enum]][[if $i]], [[end]][[goString $o.Value]]: [[goString $o.Label]][[end]]}
[[- end]]

// [[.Lower]]Label is the option label of v, or v when it has none.
func [[.Lower]]Label(labels map[string]string, v string) string {
	if l, ok := labels[v]; ok {
		return l
	}
	return v
}
[[- end]]
[[- if .RelationFields]]

// check[[.Upper]]Relation rejects an id that is not a visible row of target.
func check[[.Upper]]Relation(ctx context.Context, db *gorm.DB, target lookup.Target, field, label string, id int64) error {
	ok, err := target.Exists(ctx, db, id)
	if err != nil {
		return err
	}
	if !ok {
		return fieldError(field, "所选"+label+"不存在")
	}
	return nil
}
