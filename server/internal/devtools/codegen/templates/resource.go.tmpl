// save[[$.Upper]][[.GoName]] replaces the [[.Label]] rows of a [[$.Name]] with rows,
// in the caller's transaction. The keys must be values of [[.Spec.KeyTable]]
// and appear once; the required ones must be filled in.
func (m *Module) save[[$.Upper]][[.GoName]](ctx context.Context, tx *gorm.DB, key [[$.KeyGo]], rows [][[$.Lower]][[.GoName]]Request) error {
	keys, err := load[[$.Upper]][[.GoName]]Keys(ctx, tx)
	if err != nil {
		return err
	}
	allowed := map[string]bool{}
	for _, k := range keys {
		allowed[k.Value] = true
	}
	seen, filled := map[string]bool{}, map[string]bool{}
	for i, r := range rows {
		field := fmt.Sprintf("[[.JSONName]][%d].[[.Key.JSONName]]", i)
		k := fmt.Sprint(r.[[.Key.GoName]])
		switch {
		case seen[k]:
			return fieldError(field, "[[.Key.Label]] "+k+" 重复")
		case !allowed[k]:
			return fieldError(field, "请选择有效的[[.Key.Label]]")
		}
		seen[k], filled[k] = true, !r.empty()
	}
	for _, k := range keys {
		if k.Required && !filled[k.Value] {
			return fieldError("[[.JSONName]]", k.Label+"的[[.Label]]必须填写")
		}
	}
[[- else]]
// save[[$.Upper]][[.GoName]] replaces the [[.Label]] rows of a [[$.Name]] with rows,
// in the caller's transaction. The keys must be items of dictionary
// [[.Spec.KeyDict]] and appear once.
