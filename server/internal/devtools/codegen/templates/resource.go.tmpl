func (m *Module) export[[.PluralUpper]](c *gin.Context) {
	f, err := bind[[.Upper]]Filter(c)
	if err != nil {
		httpx.Fail(c, err)
		return
	}
	ctx := c.Request.Context()
	q := apply[[.Upper]]Filter(m.scoped[[.PluralUpper]](ctx, m.db), f)
	// Over the limit set in 基础设置 the export is refused, never cut short.
	maxRows, err := export.Check(ctx, m.db, q)
	if err != nil {
		httpx.Fail(c, err)
		return
	}
[[- range .ExportDicts]]
	[[.JSONName]]Labels, err := dictLabels(ctx, m.dict, [[goString .Dict]])
	if err != nil {
		httpx.Fail(c, err)
		return
	}
[[- end]]
	var rows [][[.Lower]]Row
	if err := select[[.PluralUpper]](q).Order("[[.Order]]").Limit(maxRows).Scan(&rows).Error; err != nil {
		httpx.Fail(c, err)
		return
	}

	filename := fmt.Sprintf("[[.URLName]]-%s.csv", time.Now().Format("20060102-150405"))
	c.Header("Content-Type", "text/csv; charset=utf-8")
	c.Header("Content-Disposition", `attachment; filename="`+filename+`"`)
	// UTF-8 BOM so spreadsheet tools detect the encoding of Chinese text.
	_, _ = c.Writer.WriteString("\xef\xbb\xbf")
	w := csv.NewWriter(c.Writer)
	// Times are written in UTC, as the headers say.
	_ = w.Write([]string{[[range $i, $f := .ExportFields]][[if $i]], [[end]][[if eq $f.Kind "time"]]export.TimeHeader([[goString $f.Label]])[[else]][[goString $f.Label]][[end]][[end]]})
	for _, r := range rows {
		_ = w.Write([]string{
[[- range .ExportFields]]
[[- if eq .Role "status"]]
			[[$.Lower]]StatusLabels[int(r.Status)],
[[- else if and (eq .Role "dept_id") $.DeptJoin]]
			csvValue(r.DeptName), // the department name instead of its ID
[[- else if .Relation]]
			csvValue([[if .ExtraGo]]relationLabel(r.[[.LabelGo]], r.[[.ExtraGo]])[[else]]r.[[.LabelGo]][[end]]), // the [[.Label]] name instead of its ID
[[- else if .Enum]]
			[[$.Lower]]Label([[$.Lower]][[.GoName]]Labels, optionKey(r.[[.GoName]])), // the option instead of its value
[[- else if .Dict]]
			[[$.Lower]]Label([[.JSONName]]Labels, optionKey(r.[[.GoName]])), // the dictionary label instead of the value
[[- else]]
			csvValue(r.[[.GoName]]),
[[- end]]
[[- end]]
		})
	}
	w.Flush()
}
