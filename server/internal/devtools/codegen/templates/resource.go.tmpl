	var rows [][[.Lower]]Row
	if err := q.Select([[.Lower]]Columns(q)).Order("[[.Order]]").Offset(pq.Offset()).Limit(pq.PageSize).Scan(&rows).Error; err != nil {
		return nil, err
	}
	views := make([][[.Lower]]View, len(rows))
	for i, r := range rows {
		views[i] = r.view()
	}
	return httpx.Page[[ "[" ]][[.Lower]]View]{List: views, Total: total, Page: pq.Page, PageSize: pq.PageSize}, nil
}

