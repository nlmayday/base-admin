func (m *Module) create[[.Upper]](c *gin.Context) (any, error) {
	var req [[.Lower]]Request
	if err := httpx.BindJSON(c, &req); err != nil {
		return nil, err
	}
	ctx := c.Request.Context()
[[- range .CheckDictFields]]
	if err := checkDict(ctx, m.dict, [[goString .Dict]], [[goString .JSONName]], [[goString .Label]], req.[[.GoName]]); err != nil {
		return nil, err
	}
[[- end]]
[[- range .RelationFields]]
[[- if .Nullable]]
	if req.[[.GoName]] != nil {
		if err := check[[$.Upper]]Relation(ctx, m.db, [[.RelVar]], [[goString .JSONName]], [[goString .Label]], int64(*req.[[.GoName]])); err != nil {
			return nil, err
		}
	}
[[- else]]
	if err := check[[$.Upper]]Relation(ctx, m.db, [[.RelVar]], [[goString .JSONName]], [[goString .Label]], int64(req.[[.GoName]])); err != nil {
		return nil, err
	}
[[- end]]
[[- end]]
[[- range .UploadFields]]
[[- if eq .Upload "files"]]
	if msg := attachment.RefsProblem(req.[[.GoName]]); msg != "" {
		return nil, fieldError([[goString .JSONName]], msg)
	}
[[- else if .Nullable]]
	if req.[[.GoName]] != nil {
		if msg := attachment.URLProblem(*req.[[.GoName]]); msg != "" {
			return nil, fieldError([[goString .JSONName]], msg)
		}
	}
[[- else]]
	if msg := attachment.URLProblem(req.[[.GoName]]); msg != "" {
		return nil, fieldError([[goString .JSONName]], msg)
	}
[[- end]]
[[- end]]
[[- if .Status]]
	if req.Status == 0 {
		req.Status = [[.StatusEnabled]]
	}
[[- end]]
[[- if .NeedsUID]]
	uid := actor.From(ctx).UserID()
[[- end]]
[[- if and .Dept .Dept.Nullable]]
	if dept := actor.From(ctx).Snapshot.DeptID; req.DeptID == nil && dept != nil {
		req.DeptID = (*ids.ID)(dept)
	}
[[- end]]
	var view [[.Lower]]View
	err := database.RunTx(ctx, m.db, func(tx *gorm.DB) error {
		var id int64
		err := tx.Raw(`INSERT INTO [[.Table]] ([[.InsertCols]])
			VALUES ([[.InsertVals]]) RETURNING id`,
			[[join .InsertArgs ", "]]).Scan(&id).Error
		if err != nil {
			if constraint, ok := database.UniqueConstraint(err); ok {
				return [[.Lower]]Duplicate(constraint)
			}
			return err
		}
		view, err = [[if .Dept]]reload[[else]]load[[end]][[.Upper]](ctx, tx, id)
		return err
	})
	if err != nil {
		return nil, err
	}
	return view, nil
}

func (m *Module) update[[.Upper]](c *gin.Context) (any, error) {
	id, err := httpx.PathID(c, "id")
	if err != nil {
		return nil, err
	}
	var req [[.Lower]]Request
	if err := httpx.BindJSON(c, &req); err != nil {
		return nil, err
	}
[[- if .Version]]
	if req.Version == nil {
		return nil, fieldError("version", "不能为空")
	}
[[- end]]
[[- if .Status]]
	if req.Status == 0 {
		req.Status = [[.StatusEnabled]]
	}
[[- end]]
	ctx := c.Request.Context()
[[- range .CheckDictFields]]
	if err := checkDict(ctx, m.dict, [[goString .Dict]], [[goString .JSONName]], [[goString .Label]], req.[[.GoName]]); err != nil {
		return nil, err
	}
[[- end]]
[[- range .RelationFields]]
[[- if .Nullable]]
	if req.[[.GoName]] != nil {
		if err := check[[$.Upper]]Relation(ctx, m.db, [[.RelVar]], [[goString .JSONName]], [[goString .Label]], int64(*req.[[.GoName]])); err != nil {
			return nil, err
		}
	}
[[- else]]
	if err := check[[$.Upper]]Relation(ctx, m.db, [[.RelVar]], [[goString .JSONName]], [[goString .Label]], int64(req.[[.GoName]])); err != nil {
		return nil, err
	}
[[- end]]
[[- end]]
[[- range .UploadFields]]
[[- if eq .Upload "files"]]
	if msg := attachment.RefsProblem(req.[[.GoName]]); msg != "" {
		return nil, fieldError([[goString .JSONName]], msg)
	}
[[- else if .Nullable]]
	if req.[[.GoName]] != nil {
		if msg := attachment.URLProblem(*req.[[.GoName]]); msg != "" {
			return nil, fieldError([[goString .JSONName]], msg)
		}
	}
[[- else]]
	if msg := attachment.URLProblem(req.[[.GoName]]); msg != "" {
		return nil, fieldError([[goString .JSONName]], msg)
	}
[[- end]]
[[- end]]
	sets := map[string]any{
[[- range .Writable]]
		"[[.Column]]": [[.UpdateArg]],
[[- end]]
[[- if .UpdatedBy]]
		"updated_by": actor.From(ctx).UserID(),
[[- end]]
[[- if .UpdatedAt]]
		"updated_at": gorm.Expr("now()"),
[[- end]]
	}
	var view [[.Lower]]View
	err = database.RunTx(ctx, m.db, func(tx *gorm.DB) error {
		if _, err := load[[.Upper]](ctx, tx, id); err != nil {
			return err
		}
[[- if .Version]]
		if err := updateVersioned(tx, [[.Lower]]Table, id, *req.Version, sets, [[.Lower]]Duplicate); err != nil {
			return err
		}
[[- else]]
		if err := tx.Table([[.Lower]]Table).Where("id = ?", id).Updates(sets).Error; err != nil {
			if constraint, ok := database.UniqueConstraint(err); ok {
				return [[.Lower]]Duplicate(constraint)
			}
			return err
		}
[[- end]]
		var err error
		view, err = [[if .Dept]]reload[[else]]load[[end]][[.Upper]](ctx, tx, id)
		return err
	})
	if err != nil {
		return nil, err
	}
	return view, nil
}

func (m *Module) delete[[.Upper]](c *gin.Context) (any, error) {
	id, err := httpx.PathID(c, "id")
	if err != nil {
		return nil, err
	}
	ctx := c.Request.Context()
	return nil, database.RunTx(ctx, m.db, func(tx *gorm.DB) error {
		if _, err := load[[.Upper]](ctx, tx, id); err != nil {
			return err
		}
[[- if .SoftDelete]]
		return tx.Exec(`UPDATE [[.Table]] SET [[.SoftDeleteSets]] WHERE id = ? AND deleted_at IS NULL`,
			[[if .UpdatedBy]]actor.From(ctx).UserID(), [[end]]id).Error
[[- else]]
		err := tx.Exec(`DELETE FROM [[.Table]] WHERE id = ?`, id).Error
		if database.IsForeignKeyViolation(err) {
			return httpx.Conflict("[[.Name]]已被引用，不能删除")
		}
		return err
[[- end]]
	})
}

func (m *Module) export[[.PluralUpper]](c *gin.Context) {
	f, err := bind[[.Upper]]Filter(c)
	if err != nil {
		httpx.Fail(c, err)
		return
	}
	q := apply[[.Upper]]Filter(scoped[[.PluralUpper]](c.Request.Context(), m.db), f)
	var rows [][[.Lower]]Row
	if err := q.Select([[.Lower]]Columns).Order("[[.Order]]").Limit(max[[.Upper]]ExportRows).Scan(&rows).Error; err != nil {
		httpx.Fail(c, err)
		return
	}

	filename := fmt.Sprintf("[[.URLName]]-%s.csv", time.Now().Format("20060102-150405"))
	c.Header("Content-Type", "text/csv; charset=utf-8")
	c.Header("Content-Disposition", `attachment; filename="`+filename+`"`)
	// UTF-8 BOM so spreadsheet tools detect the encoding of Chinese text.
	_, _ = c.Writer.WriteString("\xef\xbb\xbf")
	w := csv.NewWriter(c.Writer)
	_ = w.Write([]string{[[range $i, $f := .ExportFields]][[if $i]], [[end]][[goString $f.Label]][[end]]})
	for _, r := range rows {
		_ = w.Write([]string{
[[- range .ExportFields]]
[[- if eq .Role "status"]]
			[[$.Lower]]StatusLabels[int(r.Status)],
[[- else if and (eq .Role "dept_id") $.DeptJoin]]
			csvValue(r.DeptName), // the department name instead of its ID
[[- else if .Relation]]
			csvValue(r.[[.LabelGo]]), // the [[.Label]] name instead of its ID
[[- else]]
			csvValue(r.[[.GoName]]),
[[- end]]
[[- end]]
		})
	}
	w.Flush()
}
