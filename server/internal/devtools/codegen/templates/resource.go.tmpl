// scoped[[.PluralUpper]] starts a query over the [[.Name]] rows visible to the caller.
func scoped[[.PluralUpper]](ctx context.Context, db *gorm.DB) *gorm.DB {
	q := db.WithContext(ctx).Table([[.Lower]]Table + " AS t")
[[- if .DeptJoin]]
	q = q.Joins("LEFT JOIN sys_departments d ON d.id = t.dept_id")
[[- end]]
[[- range .Relations]]
	q = q.Joins(`LEFT JOIN [[.RelTable]] [[.RelAlias]] ON [[.RelAlias]].id = t.[[.Quoted]]`)
[[- end]]
[[- if .SoftDelete]]
	q = q.Where("t.deleted_at IS NULL")
[[- end]]
[[- if .Scope]]
	return actor.Scope(ctx, q, [[.Lower]]Scope)
[[- else]]
	return q
[[- end]]
}

func apply[[.Upper]]Filter(q *gorm.DB, f [[.Lower]]Filter) *gorm.DB {
[[- range .SearchFields]]
	[[.FilterApply]]
[[- end]]
	return q
}

func bind[[.Upper]]Filter(c *gin.Context) ([[.Lower]]Filter, error) {
	var f [[.Lower]]Filter
	if err := c.ShouldBindQuery(&f); err != nil {
		return f, httpx.BadRequest("查询参数错误").WithCause(err)
	}
	return f, nil
}

func (m *Module) list[[.PluralUpper]](c *gin.Context) (any, error) {
	pq, err := httpx.ParsePage(c)
	if err != nil {
		return nil, err
	}
	f, err := bind[[.Upper]]Filter(c)
	if err != nil {
		return nil, err
	}
	q := apply[[.Upper]]Filter(scoped[[.PluralUpper]](c.Request.Context(), m.db), f)
	var total int64
	if err := q.Session(&gorm.Session{}).Count(&total).Error; err != nil {
		return nil, err
	}
	var rows [][[.Lower]]Row
	if err := q.Select([[.Lower]]Columns).Order("[[.Order]]").Offset(pq.Offset()).Limit(pq.PageSize).Scan(&rows).Error; err != nil {
		return nil, err
	}
	views := make([][[.Lower]]View, len(rows))
	for i, r := range rows {
		views[i] = r.view()
	}
	return httpx.Page[[ "[" ]][[.Lower]]View]{List: views, Total: total, Page: pq.Page, PageSize: pq.PageSize}, nil
}

var err[[.Upper]]NotFound = httpx.NotFound("[[.Name]]不存在")

// load[[.Upper]] reads one visible row; rows outside the data scope are 404.
func load[[.Upper]](ctx context.Context, db *gorm.DB, id int64) ([[.Lower]]View, error) {
	var rows [][[.Lower]]Row
	if err := scoped[[.PluralUpper]](ctx, db).Select([[.Lower]]Columns).Where("t.id = ?", id).Scan(&rows).Error; err != nil {
		return [[.Lower]]View{}, err
	}
	if len(rows) == 0 {
		return [[.Lower]]View{}, err[[.Upper]]NotFound
	}
	return rows[0].view(), nil
}

