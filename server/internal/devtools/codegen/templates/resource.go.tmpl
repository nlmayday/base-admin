	for i, r := range rows {
		field := fmt.Sprintf("[[.JSONName]][%d].[[.Key.JSONName]]", i)
		k := fmt.Sprint(r.[[.Key.GoName]])
		if seen[k] {
			return fieldError(field, "[[.Key.Label]] "+k+" 重复")
		}
		seen[k] = true
		if err := checkDict(ctx, m.dict, [[goString .Spec.KeyDict]], field, [[goString .Key.Label]], r.[[.Key.GoName]]); err != nil {
			return err
		}
	}
[[- end]]
	if err := tx.Exec(`DELETE FROM [[.Table]] WHERE [[.FK.Quoted]] = ?`, key).Error; err != nil {
		return err
	}
	for _, r := range rows {
		if r.empty() {
			continue
		}
		err := tx.Exec(`INSERT INTO [[.Table]] ([[.InsertCols]]) VALUES ([[.InsertVals]])`,
			[[join .InsertArgs ", "]]).Error
		if database.IsValueTooLong(err) {
			return err[[$.Upper]]TooLong
		}
		if err != nil {
			return err
		}
	}
	return nil
}
