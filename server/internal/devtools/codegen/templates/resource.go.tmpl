	keys, err := load[[$.Upper]][[.GoName]]Keys(ctx, tx)
	if err != nil {
		return err
	}
	allowed := map[string]bool{}
	for _, k := range keys {
		allowed[k.Value] = true
	}
	seen := map[string]bool{}
	for i, r := range rows {
		field := fmt.Sprintf("[[.JSONName]][%d].[[.Key.JSONName]]", i)
		k := fmt.Sprint(r.[[.Key.GoName]])
		switch {
		case seen[k]:
			return fieldError(field, "[[.Key.Label]] "+k+" 重复")
		case !allowed[k]:
			return fieldError(field, "请选择有效的[[.Key.Label]]")
		}
		seen[k] = true
[[- template "childUploads" .]]
	}
	if err := m.write[[$.Upper]][[.GoName]](tx, key, rows); err != nil {
		return err
	}
	var stored [][[.Key.RowType]]
	if err := tx.Table("[[.Table]]").Where("[[.FK.Quoted]] = ?", key).Pluck("[[.Key.Quoted]]", &stored).Error; err != nil {
		return err
	}
	filled := map[string]bool{}
	for _, k := range stored {
		filled[fmt.Sprint(k)] = true
	}
	for _, k := range keys {
		if k.Required && !filled[k.Value] {
			return fieldError("[[.JSONName]]", k.Label+"的[[.Label]]必须填写")
		}
	}
	return nil
}
