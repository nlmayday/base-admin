// check[[.Upper]]Relation rejects an id that is not a visible row of target.
func check[[.Upper]]Relation(ctx context.Context, db *gorm.DB, target lookup.Target, field, label string, id int64) error {
	ok, err := target.Exists(ctx, db, id)
	if err != nil {
		return err
	}
	if !ok {
		return fieldError(field, "所选"+label+"不存在")
	}
	return nil
}
