// save[[$.Upper]][[.GoName]] writes the [[.Label]] rows of a [[$.Name]] given in rows, in the
// caller's transaction: the row of each given [[.Key.Label]] is replaced (one
// with every field empty is removed), rows of other [[.Key.Label]] values, such
// as those [[.Spec.KeyTable]] no longer lists, are kept. The keys must be
// values of [[.Spec.KeyTable]] and appear once; the required ones must be
// filled in.
func (m *Module) save[[$.Upper]][[.GoName]](ctx context.Context, tx *gorm.DB, key [[$.KeyGo]], rows [][[$.Lower]][[.GoName]]Request) error {
