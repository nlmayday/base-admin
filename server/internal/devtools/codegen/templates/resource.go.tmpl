// reload[[.Upper]] re-reads a written row inside the transaction, so a row
// moved outside the caller's data scope is rejected and rolled back.
func reload[[.Upper]](ctx context.Context, tx *gorm.DB, id int64) ([[.Lower]]View, error) {
	v, err := load[[.Upper]](ctx, tx, id)
	if errors.Is(err, err[[.Upper]]NotFound) {
		return v, fieldError("deptId", "所选部门不在您的数据范围内")
	}
	return v, err
}
