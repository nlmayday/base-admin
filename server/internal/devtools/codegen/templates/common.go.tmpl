// csvCell neutralizes spreadsheet formula injection.
func csvCell(s string) string {
	if s != "" && strings.ContainsRune("=+-@\t\r", rune(s[0])) {
		return "'" + s
	}
	return s
}

// csvValue formats one export cell; nil pointers are empty and strings are
// guarded against formula injection.
func csvValue(v any) string {
	rv := reflect.ValueOf(v)
	if rv.Kind() == reflect.Pointer {
		if rv.IsNil() {
			return ""
		}
		v = rv.Elem().Interface()
	}
	switch x := v.(type) {
	case nil:
		return ""
	case string:
		return csvCell(x)
	case time.Time:
		return x.UTC().Format(time.DateTime) // the header says (UTC)
	case bool:
		if x {
			return "是"
		}
		return "否"
	default:
		return csvCell(fmt.Sprint(x))
	}
}
