# Copy to prod.env (never commit it) and replace every value.
POSTGRES_USER=admin
# The raw password, any characters (no URL encoding: the API encodes it).
# Compose expands $ in this file; wrap a password containing $ in single
# quotes, e.g. POSTGRES_PASSWORD='pa$$word'.
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=base_admin
REDIS_PASSWORD=change-me-strong-redis-password

# The browser origin users open, e.g. https://admin.example.com (no path).
PUBLIC_ORIGIN=https://admin.example.com
WEB_PORT=80

# First super admin (only used when no user exists; must be changed at first login).
BOOTSTRAP_ADMIN_PASSWORD=change-me-12+chars

# HMAC key for signed file URLs: at least 32 random bytes, e.g. `openssl rand -hex 32`.
FILE_SIGNING_KEY=change-me-64-hex-chars

# Shown in 服务器监控 and stamped into the API binary at build time.
APP_VERSION=1.0.0
